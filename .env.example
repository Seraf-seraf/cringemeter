# Настоящие секреты храните вне Git.
# .env автоматически не загружается: передайте значения процессу/Vercel.

# Обязательные настройки webhook.
# Токен нужного бота из @BotFather (<bot_id>:<token>).
TELEGRAM_BOT_TOKEN=
# Отдельный секрет setWebhook.secret_token; 1–256 символов A-Za-z0-9_-.
TELEGRAM_WEBHOOK_SECRET=
# Отрицательный числовой ID группы, не username.
TELEGRAM_CHAT_ID=-1001234567890
# URL целевой Turso без query-параметров; нужен также для миграций/operations.
TURSO_DATABASE_URL=libsql://example.turso.io
# Токен этой БД с правом записи и создания схемы.
TURSO_AUTH_TOKEN=

# Только для /api/operations: отдельный секрет X-Cringemeter-Admin-Secret.
# Без него endpoint закрыт. Для webhook и go run ./cmd/migrate не требуется.
CRINGEMETER_ADMIN_SECRET=
